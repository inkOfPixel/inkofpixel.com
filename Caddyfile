# Serves the built site (/srv) behind kamal-proxy, which terminates TLS.
{
	admin off
	auto_https off
	# kamal-proxy sits in front: keep the visitor's address it forwards.
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	root * /srv
	encode zstd gzip

	# Health check used by kamal-proxy.
	respond /up 200

	# One canonical host.
	@www host www.inkofpixel.com
	redir @www https://inkofpixel.com{uri} 301

	# Addresses of the old site that changed (generated by the build).
	import /etc/caddy/redirects.caddy

	# One address per page: no trailing slash, except the home of each language.
	redir /it /it/ 301
	@trailing {
		path_regexp trailing ^(/.+)/$
		not path /it/
	}
	redir @trailing {re.trailing.1} 301

	# Fingerprinted files never change; images may be replaced under the same name.
	header /_/* Cache-Control "public, max-age=31536000, immutable"
	header /assets/* Cache-Control "public, max-age=604800"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# The contact form is handled by the small Node server in the same container.
	reverse_proxy /api/* 127.0.0.1:3001

	# /it/servizi -> /it/servizi.html
	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors {
		handle /it/* {
			rewrite * /it/404.html
			file_server
		}
		handle {
			rewrite * /404.html
			file_server
		}
	}
}
